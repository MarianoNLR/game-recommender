// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id            Int      @id @default(autoincrement())
  name          String
  budget        Float?
  accessCode    String   @unique
  expiresAt     DateTime
  createdFromIp String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberSteamIds String[]
}

model Game {
  steamAppId    Int      @id
  name          String
  description   String?
  releaseDate   DateTime?

  reviewPercentage Int?
  reviewCount      Int?

  isFree        Boolean?
  price         Int?
  initialPrice  Int?
  discount      Int?

  lastInfoUpdate  DateTime?

  isMultiplayer Boolean @default(false)

  imageUrl String?

  tags          GameTag[]
  categories  GameCategory[]
}

model Tag {
  id       Int      @id @default(autoincrement())
  steamTagId Int?   @unique
  name     String   @unique

  games    GameTag[]
}

model GameTag {
  gameId Int
  tagId  Int
  weight Int

  game Game @relation(fields: [gameId], references: [steamAppId])
  tag  Tag  @relation(fields: [tagId], references: [steamTagId])

  @@id([gameId, tagId])
}

model Category {
  steamCategoryId Int            @id
  internalName    String
  displayName     String

  games           GameCategory[]
}

model GameCategory {
  steamAppId Int
  categoryId Int

  game       Game     @relation(fields: [steamAppId], references: [steamAppId])
  category   Category @relation(fields: [categoryId], references: [steamCategoryId])

  @@id([steamAppId, categoryId])
}